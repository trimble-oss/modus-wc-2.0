# Enforce LF line endings in the repository to prevent CRLF↔LF diff noise
# when contributors work on Windows vs macOS/Linux.
* text=auto eol=lf

# Generated files — always LF
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.razor    text eol=lf
*.razor.cs text eol=lf
*.cs   text eol=lf
*.csproj text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary — never normalise
*.woff2 binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
