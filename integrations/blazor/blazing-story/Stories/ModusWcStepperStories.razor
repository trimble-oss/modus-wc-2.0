@attribute [Stories("Navigation/Stepper")]

<Stories TComponent="ModusWcStepper">

    <Story Name="Default">
        <Template>
            <ModusWcStepper Steps="@_steps" Orientation="horizontal" />
        </Template>
    </Story>

</Stories>

@code {

    private object[] _steps = [
        new { label = "Step 1", color = "primary" },
        new { label = "Step 2", color = "primary" },
        new { label = "Step 3", color = "warning" },
        new { label = "Step 4", color = "secondary" },
    ];
}
