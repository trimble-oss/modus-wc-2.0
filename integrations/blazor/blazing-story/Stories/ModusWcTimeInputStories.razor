@attribute [Stories("Inputs/Time Input")]

<Stories TComponent="ModusWcTimeInput">

    <Story Name="Default">
        <Template>
            <ModusWcTimeInput Label="Select time" />
        </Template>
    </Story>

    <Story Name="Time Input - AutoComplete On">
        <Template>
            <ModusWcTimeInput AutoComplete="on" Label="Select time" />
        </Template>
    </Story>

    <Story Name="Time Input - AutoComplete Off">
        <Template>
            <ModusWcTimeInput AutoComplete="off" Label="Select time" />
        </Template>
    </Story>
</Stories>
