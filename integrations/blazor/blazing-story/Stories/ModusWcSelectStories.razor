@attribute [Stories("Inputs/Select")]

<Stories TComponent="ModusWcSelect">

    <Story Name="Default">
        <Template>
            <ModusWcSelect Label="Choose an option" Options="@_options" Value="@_selectedValue" />
        </Template>
    </Story>

</Stories>

@code {

    private object[] _options = [
        new { label = "Option 1", value = "option1" },
        new { label = "Option 2", value = "option2" },
        new { label = "Option 3", value = "option3" },
    ];
    private string _selectedValue = "option1";
}
