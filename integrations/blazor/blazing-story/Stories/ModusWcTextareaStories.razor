    <Story Name="Default">
        <Template>
            <ModusWcTextarea Label="Comments" Placeholder="Enter your comments…" />
        </Template>
    </Story>

    <Story Name="Textarea - AutoCorrect On">
        <Template>
            <ModusWcTextarea AutoCorrect="on" Label="Comments" Placeholder="Enter your comments…" />
