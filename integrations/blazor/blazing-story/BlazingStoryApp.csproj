<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by BlazingStory -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <MD2RazorDefaultBaseClass>global::BlazingStory.Internals.Pages.MarkdownPageBase</MD2RazorDefaultBaseClass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
    <PackageReference Include="BlazingStory" Version="1.0.0-preview.75" />
    <PackageReference Include="MD2RazorGenerator" Version="1.2.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\stencil-generated\ModusWebComponents.Blazor\ModusWebComponents.Blazor.csproj" />
  </ItemGroup>

  <!--
    Copy the Stencil web-component bundle (produced by `npm run build` at the repo
    root) into wwwroot/dist/esm so the browser can load custom-element definitions.
    The iframe.html references this bundle; scripts go there, not in index.html.
  -->
  <PropertyGroup>
    <StencilEsmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)','..','..','..','dist','esm'))</StencilEsmDir>
    <WwwrootDistDir>$(MSBuildProjectDirectory)\wwwroot\dist\esm</WwwrootDistDir>
    <StencilStylesDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)','..','..','..','dist'))</StencilStylesDir>
  </PropertyGroup>

  <Target Name="CopyStencilBundle" BeforeTargets="Build">
    <Message Text="Copying Stencil ESM bundle from $(StencilEsmDir) →  wwwroot/dist/esm" Importance="normal" />
    <ItemGroup>
      <StencilFiles Include="$(StencilEsmDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(StencilFiles)"
          DestinationFiles="@(StencilFiles->'$(WwwrootDistDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(StencilStylesDir)\modus-wc-styles.css"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\css"
          SkipUnchangedFiles="true"
          Condition="Exists('$(StencilStylesDir)\modus-wc-styles.css')" />
  </Target>

</Project>
