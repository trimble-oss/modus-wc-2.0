<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>ModusWebComponents.Blazor</Title>
    <Version>1.3.0</Version>
    <Description>Auto-generated Blazor Razor Class Library wrappers for Stencil web components.</Description>
    <StaticWebAssetBasePath>_content/$(MSBuildProjectName)</StaticWebAssetBasePath>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <NoWarn>1701;1702;1591;1570</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <NoWarn>1701;1702;1591;1570</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <!--
    Copy the Stencil-generated CSS and font assets into wwwroot so they are
    served as static web assets at _content/ModusWebComponents.Blazor/modus-wc-styles.css
    (and ./assets/…).  This runs before every build so the RCL always reflects
    the latest Stencil output even when only the JS bundle is rebuilt.
  -->
  <PropertyGroup>
    <StencilDistDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../../../dist'))</StencilDistDir>
  </PropertyGroup>

  <Target Name="CopyStencilStyles" BeforeTargets="Build"
          Condition="Exists('$(StencilDistDir)modus-wc-styles.css')">
    <Message Text="Copying Stencil styles from $(StencilDistDir) → wwwroot" Importance="normal" />
    <Copy SourceFiles="$(StencilDistDir)modus-wc-styles.css"
          DestinationFolder="$(MSBuildProjectDirectory)/wwwroot"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <StencilAssetFiles Include="$(StencilDistDir)styles/assets/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(StencilAssetFiles)"
          DestinationFiles="@(StencilAssetFiles->'$(MSBuildProjectDirectory)/wwwroot/assets/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
