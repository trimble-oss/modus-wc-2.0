@namespace ModusWebComponents.Blazor

<modus-wc-slider custom-class="@CustomClass"
                 disabled="@(Disabled?.ToString().ToLower())"
                 input-id="@InputId"
                 input-tab-index="@InputTabIndex"
                 label="@Label"
                 max="@Max"
                 min="@Min"
                 name="@Name"
                 required="@(Required?.ToString().ToLower())"
                 size="@Size"
                 step="@Step"
                 value="@Value"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-slider>
