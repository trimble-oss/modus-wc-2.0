@namespace ModusWebComponents.Blazor

<modus-wc-alert alert-description="@AlertDescription"
                 alert-title="@AlertTitle"
                 custom-class="@CustomClass"
                 delay="@Delay"
                 dismissible="@(Dismissible?.ToString().ToLower())"
                 icon="@Icon"
                 variant="@Variant"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-alert>
