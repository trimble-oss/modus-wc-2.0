@namespace ModusWebComponents.Blazor

<modus-wc-table caption="@Caption"
                 current-page="@CurrentPage"
                 custom-class="@CustomClass"
                 density="@Density"
                 hover="@(Hover?.ToString().ToLower())"
                 paginated="@(Paginated?.ToString().ToLower())"
                 selectable="@Selectable"
                 show-page-size-selector="@(ShowPageSizeSelector?.ToString().ToLower())"
                 sortable="@(Sortable?.ToString().ToLower())"
                 zebra="@(Zebra?.ToString().ToLower())"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-table>
