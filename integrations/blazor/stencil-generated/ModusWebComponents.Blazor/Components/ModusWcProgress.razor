@namespace ModusWebComponents.Blazor

<modus-wc-progress custom-class="@CustomClass"
                 indeterminate="@(Indeterminate?.ToString().ToLower())"
                 label="@Label"
                 max="@Max"
                 value="@Value"
                 variant="@Variant"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-progress>
