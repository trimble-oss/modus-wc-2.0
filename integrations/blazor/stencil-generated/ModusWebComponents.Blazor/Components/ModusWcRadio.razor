@namespace ModusWebComponents.Blazor

<modus-wc-radio custom-class="@CustomClass"
                 disabled="@(Disabled?.ToString().ToLower())"
                 input-id="@InputId"
                 input-tab-index="@InputTabIndex"
                 label="@Label"
                 name="@Name"
                 required="@(Required?.ToString().ToLower())"
                 size="@Size"
                 value="@(Value?.ToString().ToLower())"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-radio>
