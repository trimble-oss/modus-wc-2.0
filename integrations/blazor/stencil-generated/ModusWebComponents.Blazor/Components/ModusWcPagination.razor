                 next-button-text="@NextButtonText"
                 page="@Page"
                 prev-button-text="@PrevButtonText"
                 size="@Size"
                 @ref="_elementRef"
                 @attributes="AdditionalAttributes">
    @ChildContent
</modus-wc-pagination>
