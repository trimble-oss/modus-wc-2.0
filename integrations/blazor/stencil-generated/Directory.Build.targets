<Project>
  <!--
    Extends the auto-generated .csproj with additional asset copies that cannot
    be added to the generated file (it is overwritten on every `stencil build`).

    CopyLoaderAssets uses AfterTargets="CopyStencilDistAssets" and the same TFM
    condition so it runs exactly once per build, after dist/loader/ files are
    available in the Stencil output directory.
  -->
  <Target Name="CopyLoaderAssets" AfterTargets="CopyStencilDistAssets"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <_LoaderFiles Include="$(StencilRoot)/dist/loader/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(_LoaderFiles)"
          DestinationFiles="@(_LoaderFiles->'$(MSBuildProjectDirectory)/wwwroot/loader/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
