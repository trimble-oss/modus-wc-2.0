<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ModusWebComponents.MauiApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationId>com.trimble.moduswebcomponents.mauiapp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <PackageReference Include="BlazingStory" Version="1.0.0-preview.75" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\stencil-generated\ModusWebComponents.Blazor\ModusWebComponents.Blazor.csproj" />
  </ItemGroup>

  <!--
    BlazingStory discovers story components by scanning assemblies for types with
    the [Stories] attribute. The story .razor files must be compiled into this
    app's assembly. They are generated by `npm run generate:blazor-stories`.
    EmbeddedResource enables the "Show code" feature in BlazingStory.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Stories/**/*.razor" />
  </ItemGroup>

</Project>
