exports[`modus-wc-tabs should render tabs with slotName property 1`] = `
<modus-wc-tabs>
  <!---->
  <div aria-label="Tab Group with Slots" class="modus-wc-tabs modus-wc-tabs-bordered modus-wc-tabs-md" role="tablist">
    <button aria-controls="modus-wc-tabpanel-test-random-id-0" aria-selected="true" class="modus-wc-tab modus-wc-tab-active" id="modus-wc-tab-test-random-id-0" role="tab" tabindex="0">
      <div slot="custom-tab-slot-1">
        Custom Tab Content
      </div>
    </button>
    <button aria-controls="modus-wc-tabpanel-test-random-id-1" aria-label="Regular Tab" aria-selected="false" class="modus-wc-tab" id="modus-wc-tab-test-random-id-1" role="tab" tabindex="-1">
      <span>
        Regular Tab
      </span>
    </button>
  </div>
  <div class="modus-wc-tab-panel">
    <div aria-labelledby="modus-wc-tab-test-random-id-0" class="modus-wc-tab-active" id="modus-wc-tabpanel-test-random-id-0" role="tabpanel" tabindex="0">
      <div slot="tab-0">
        Tab Panel Content
      </div>
    </div>
    <div aria-labelledby="modus-wc-tab-test-random-id-1" hidden="" id="modus-wc-tabpanel-test-random-id-1" role="tabpanel" tabindex="-1"></div>
  </div>
</modus-wc-tabs>
`;

