exports[`modus-wc-empty-state should render with default props 1`] = `
<modus-wc-empty-state action-label="Action" heading="Title for Empty State" subtitle="Subtitle">
  <div class="modus-wc-empty-state modus-wc-empty-state--compact">
    <div aria-hidden="true" class="modus-wc-empty-state-illustration modus-wc-empty-state-illustration--compact modus-wc-empty-state-illustration--selection-plus">
      <span>
