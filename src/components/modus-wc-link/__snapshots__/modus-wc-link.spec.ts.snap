// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`modus-wc-link should render a leading icon when the start-icon slot is set 1`] = `
<modus-wc-link href="#">
  <!---->
  <a class="modus-wc-link modus-wc-link-color-primary" href="#">
    <modus-wc-icon class="modus-wc-flex modus-wc-items-center" name="link-simple" slot="start-icon">
      <i aria-hidden="true" class="modus-icon-link-simple modus-wc-icon modus-wc-icon--md" tabindex="-1" style="mask-image: var(--modus-icon-link-simple); webkit-mask-image: var(--modus-icon-link-simple);"></i>
    </modus-wc-icon>
    <span class="modus-wc-link-label">
      Click me
    </span>
  </a>
</modus-wc-link>
`;

