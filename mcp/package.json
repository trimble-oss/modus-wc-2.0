{
  "name": "@trimble-oss/moduswebcomponents-mcp",
  "version": "1.0.0",
  "description": "MCP server for Modus Web Components documentation",
  "type": "module",
  "bin": {
    "moduswebcomponents-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "versions"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "extract-docs": "tsx scripts/extract-docs.ts",
    "extract-blazor-docs": "tsx scripts/extract-blazor-docs.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "@hono/node-server": "2.0.12",
    "ip-address": "10.4.0",
    "qs": "6.15.2",
    "body-parser": "2.3.0",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "modus",
    "trimble",
    "web-components",
    "documentation"
  ],
  "license": "MIT"
}
