# Stencil
.stencil/
# Stencil-generated integration wrappers — rebuilt by `stencil build` / `npm run build:ci`.
# Never commit these; they are regenerated automatically.
/integrations/angular/**/stencil-generated/
/integrations/react/stencil-generated/
/integrations/vue/stencil-generated/
# Blazor: ignore the generated RCL directory but keep Directory.Build.props (handwritten MSBuild config)
/integrations/blazor/stencil-generated/ModusWebComponents.Blazor/

# BlazingStory generated story files (regenerated by scripts/generate-blazor-stories.js)
/integrations/blazor/blazing-story/Stories/*Stories.razor

# Test coverage
coverage/

# IDE and editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
*.log

nuget-output/
